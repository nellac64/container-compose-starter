# config for all
COMPOSE_PROJECT_NAME=app-stack
#================
# Redis config
#================
REDIS_IMAGE=docker.1ms.run/redis
REDIS_IMAGE_VERSION=6.0.8
REDIS_CONTAINER_NAME=my_redis
REDIS_HOST_PORT=6389
REDIS_CONT_PORT=6379
REDIS_COMMAND=redis-server /etc/redis/redis.conf
REDIS_HOST_PATH_CONFIG=/app/redis/redis.conf
REDIS_CONT_PATH_CONFIG=/etc/redis/redis.conf
REDIS_HOST_PATH_DATA=/app/redis/data
REDIS_CONT_PATH_DATA=/data
#================
# RabbitMQ config
#================
RABBITMQ_IMAGE=docker.1ms.run/library/rabbitmq
RABBITMQ_IMAGE_VERSION=3.13-management-alpine
RABBITMQ_CONTAINER_NAME=my_rabbitmq
RABBITMQ_HOST_PORT=5672
RABBITMQ_CONT_PORT=5672
RABBITMQ_HOST_MGMT_PORT=15672
RABBITMQ_CONT_MGMT_PORT=15672
RABBITMQ_HOST_PATH_DATA=/app/rabbitmq/data
RABBITMQ_CONT_PATH_DATA=/var/lib/rabbitmq
RABBITMQ_DEFAULT_USER=root
RABBITMQ_DEFAULT_PASS=123456
#================
# MySQL config
#================
MYSQL_IMAGE=docker.1ms.run/mysql/mysql-server
MYSQL_IMAGE_VERSION=5.7
MYSQL_CONTAINER_NAME=my_mysql
MYSQL_HOST_PORT=3306
MYSQL_CONT_PORT=3306
MYSQL_HOST_PATH_CONFIG=/app/mysql/conf/my.cnf
MYSQL_CONT_PATH_CONFIG=/etc/my.cnf
MYSQL_HOST_PATH_DATA=/app/mysql/data
MYSQL_CONT_PATH_DATA=/var/lib/mysql
MYSQL_ROOT_PASSWORD=123456
#================
# Nginx config
#================
NGINX_IMAGE=docker.1ms.run/library/nginx
NGINX_IMAGE_VERSION=stable-alpine3.23
NGINX_CONTAINER_NAME=my_nginx
NGINX_HOST_HTTP_PORT=80
NGINX_CONT_HTTP_PORT=80
NGINX_HOST_HTTPS_PORT=443
NGINX_CONT_HTTPS_PORT=443
# Nginx paths
NGINX_HOST_HTML_PATH=/app/nginx/html
NGINX_CONT_HTML_PATH=/usr/share/nginx/html

NGINX_HOST_CONF_PATH=/app/nginx/conf/nginx.conf
NGINX_CONT_CONF_PATH=/etc/nginx/nginx.conf

NGINX_HOST_CONF_D_PATH=/app/nginx/conf.d
NGINX_CONT_CONF_D_PATH=/etc/nginx/conf.d

NGINX_HOST_LOGS_PATH=/app/nginx/logs
NGINX_CONT_LOGS_PATH=/var/log/nginx

NGINX_HOST_SSL_PATH=/app/nginx/ssl
NGINX_CONT_SSL_PATH=/etc/ssl
#================
# Nacos config
#================
NACOS_CONTAINER_NAME=my_nacos
NACOS_IMAGE=docker.1ms.run/nacos/nacos-server
NACOS_IMAGE_VERSION=v2.4.3
NACOS_HOST_PORT=8848
NACOS_CONT_PORT=8848
NACOS_HOST_GRPC_PORT=9848
NACOS_CONT_GRPC_PORT=9848
NACOS_MODE=standalone
#================
# Sentinel config
#================
SENTINEL_CONTAINER_NAME=my_sentinel
SENTINEL_IMAGE=docker.1ms.run/bladex/sentinel-dashboard
SENTINEL_IMAGE_VERSION=1.8.6
SENTINEL_HOST_PORT=8858
SENTINEL_CONT_PORT=8858
SENTINEL_HOST_CLIENT_PORT=8719
SENTINEL_CONT_CLIENT_PORT=8719
#================
# Prometheus config
#================
PROMETHEUS_CONTAINER_NAME=my_promethues
PROMETHEUS_IMAGE_NAME=docker.1ms.run/prom/prometheus
PROMETHEUS_IMAGE_VERSION=v3.5.1
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_CONT_PORT=9090
PROMETHEUS_HOST_CONFIG_PATH=/app/prometheus/config
PROMETHEUS_CONT_CONFIG_PATH=/etc/prometheus
PROMETHEUS_HOST_DATA_PATH=/app/prometheus/data/prometheus
PROMETHEUS_CONT_DATA_PATH=/prometheus
#================
# Prometheus PushGateway config
#================
PUSHGATEWAY_CONTAINER_NAME=my_pushgateway
PUSHGATEWAY_IMAGE_NAME=docker.1ms.run/prom/pushgateway
PUSHGATEWAY_IMAGE_VERSION=v1.11.2
PUSHGATEWAY_HOST_PORT=9091
PUSHGATEWAY_CONT_PORT=9091
PUSHGATEWAY_HOST_DATA_PATH=/app/pushgateway/data
PUSHGATEWAY_CONT_DATA_PATH=/prometheus
#================
# Grafana config
#================
GRAFANA_CONTAINER_NAME=my_grafana
GRAFANA_IMAGE_NAME=docker.1ms.run/grafana/grafana
GRAFANA_IMAGE_VERSION=10.2.9
GRAFANA_HOST_PORT=3000
GRAFANA_CONT_PORT=3000

GRAFANA_HOST_DATA_PATH=/app/grafana/data/grafana
GRAFANA_CONT_DATA_PATH=/var/lib/grafana

GRAFANA_HOST_CONFIG_PATH=/app/grafana/config/grafana
GRAFANA_CONT_CONFIG_PATH=/etc/grafana

GRAFANA_HOST_LOG_PATH=/app/grafana/log/grafana
GRAFANA_CONT_LOG_PATH=/var/log/grafana
#================
# Prometheus Exporter config
#================
EXPORTER_CONTAINER_NAME=my_node_exporter
EXPORTER_IMAGE_NAME=docker.1ms.run/prom/node-exporter
EXPORTER_IMAGE_VERSION=v1.10.2
EXPORTER_HOST_PORT=9100
EXPORTER_CONT_PORT=9100

EXPORTER_HOST_ROOT_PATH=/
EXPORTER_CONT_ROOT_PATH=/rootfs

EXPORTER_HOST_PROC_PATH=/proc
EXPORTER_CONT_PROC_PATH=/host/proc

EXPORTER_HOST_SYS_PATH=/sys
EXPORTER_CONT_SYS_PATH=/host/sys

EXPORTER_HOST_RUN_PATH=/run
EXPORTER_CONT_RUN_PATH=/run

EXPORTER_HOST_MACHINE_ID_PATH=/etc/machine-id
EXPORTER_CONT_MACHINE_ID_PATH=/etc/machine-id
#================
# Cadvisor config
#================
CADVISOR_CONTAINER_NAME=my_cadvisor
CADVISOR_IMAGE_NAME=gcr.io/cadvisor/cadvisor
CADVISOR_IMAGE_VERSION=v0.49.1
CADVISOR_HOST_PORT=8080
CADVISOR_CONT_PORT=8080
CADVISOR_HOST_ROOT_PATH=/
CADVISOR_CONT_ROOT_PATH=/rootfs
CADVISOR_HOST_RUN_PATH=/var/run
CADVISOR_CONT_RUN_PATH=/var/run
CADVISOR_HOST_SYS_PATH=/sys
CADVISOR_CONT_SYS_PATH=/sys
CADVISOR_HOST_DOCKER_PATH=/var/lib/docker
CADVISOR_CONT_DOCKER_PATH=/var/lib/docker
CADVISOR_HOST_DISK_PATH=/dev/disk
CADVISOR_CONT_DISK_PATH=/dev/disk