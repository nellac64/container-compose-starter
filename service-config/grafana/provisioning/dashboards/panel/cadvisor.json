{
    "id": null,
    "uid": "cadvisor",
    "title": "Container Monitoring",
    "tags": ["container", "cadvisor", "docker"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "panels": [
        {
            "id": 1,
            "title": "Container CPU Usage",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": null
            },
            "targets": [
                {
                    "expr": "sum by(name) (rate(container_cpu_usage_seconds_total{image!=\"\"}[5m])) * 100",
                    "legendFormat": "{{name}}"
                }
            ],
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
        },
        {
            "id": 2,
            "title": "Container Memory Usage",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": null
            },
            "targets": [
                {
                    "expr": "sum by(name) (container_memory_usage_bytes{image!=\"\"}) / 1024 / 1024",
                    "legendFormat": "{{name}}"
                }
            ],
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
        },
        {
            "id": 3,
            "title": "Container Network Receive",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": null
            },
            "targets": [
                {
                    "expr": "sum by(name) (rate(container_network_receive_bytes_total{image!=\"\"}[5m])) / 1024 / 1024",
                    "legendFormat": "{{name}}"
                }
            ],
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
        },
        {
            "id": 4,
            "title": "Container Network Transmit",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": null
            },
            "targets": [
                {
                    "expr": "sum by(name) (rate(container_network_transmit_bytes_total{image!=\"\"}[5m])) / 1024 / 1024",
                    "legendFormat": "{{name}}"
                }
            ],
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
        }
    ]
}